{
  "compilerOptions": {
    "target": "ES2023",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.proxy.ts", "vite.proxy.test.ts", "e2e/**/*.ts"]
}
